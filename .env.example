# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Embeddings – lokal via Ollama ─────────────────────────────────────────────
# nomic-embed-text: ollama pull nomic-embed-text
#
# Dieser Wert gilt für das Ingestion-Skript (läuft direkt auf dem Host):
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama
#
# Der MCP-Server (läuft in Docker) überschreibt EMBEDDING_BASE_URL automatisch
# auf http://host.docker.internal:11434/v1 — siehe docker-compose.yml.

# ── MCP-Server ────────────────────────────────────────────────────────────────
MCP_DEFAULT_TOP_K=5

# ── Ingestion Chunking ────────────────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# ── Datenbankverbindung ───────────────────────────────────────────────────────
# Für Ingestion-Skript (läuft auf Host, PostgreSQL via Docker-Port 5431):
DATABASE_URL=postgresql://retriever:changeme@localhost:5431/knowledge
#
# Hinweis: Für MCP-Server wird die DB-Verbindung im docker-compose automatisch gesetzt.
